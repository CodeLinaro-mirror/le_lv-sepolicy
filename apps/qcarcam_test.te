policy_module(qcarcam_test, 1.0)

########################################
#
# Declarations
#
type qcarcam_test_t;

type qcarcam_test_exec_t;
init_daemon_domain(qcarcam_test_t, qcarcam_test_exec_t)

type qcarcam_test_data_t;
files_type(qcarcam_test_data_t)

type qcarcam_test_var_run_t;
files_type(qcarcam_test_var_run_t)

#######################################
require {
        type ais_server_t;
        type ais_server_data_t;
        type default_t;
        type device_t;
        type devlog_t;
        type dri_device_t;
        type etc_t;
        type init_var_run_t;
        type locale_t;
        type qcarcam_test_t;
        type sysadm_t;
        type sysfs_t;
        type syslogd_t;
        type syslogd_var_run_t;
        type tmp_t;
        type user_runtime_root_t;
        type user_runtime_t;
        type user_tmp_t;
        type usr_t;
        class capability { dac_override sys_admin };
        class chr_file { ioctl open read write };
        class dir  { search add_name write };
        class file { getattr create open read write append };
        class lnk_file read;
        class sock_file write;
        class unix_dgram_socket { connect create sendto write };
        class unix_stream_socket connectto;
}

allow qcarcam_test_t ais_server_data_t:dir search;
allow qcarcam_test_t ais_server_data_t:file { getattr open read };
allow qcarcam_test_t ais_server_t:unix_stream_socket connectto;
allow qcarcam_test_t default_t:dir search;
allow qcarcam_test_t default_t:file { getattr open read };
allow qcarcam_test_t device_t:chr_file { ioctl open read };
allow qcarcam_test_t devlog_t:sock_file write;
allow qcarcam_test_t dri_device_t:chr_file { ioctl open read write };
allow qcarcam_test_t etc_t:lnk_file read;
allow qcarcam_test_t init_var_run_t:dir search;
allow qcarcam_test_t locale_t:dir search;
allow qcarcam_test_t locale_t:file { getattr open read };
allow qcarcam_test_t self:capability { dac_override sys_admin };
allow qcarcam_test_t self:unix_dgram_socket { connect create write };
allow qcarcam_test_t sysadm_t:unix_stream_socket connectto;
allow qcarcam_test_t sysfs_t:file { getattr open read write };
allow qcarcam_test_t sysfs_t:lnk_file read;
allow qcarcam_test_t syslogd_t:unix_dgram_socket sendto;
allow qcarcam_test_t syslogd_var_run_t:dir search;
allow qcarcam_test_t tmp_t:dir { search add_name write };
allow qcarcam_test_t tmp_t:file { append create getattr open read write };
allow qcarcam_test_t tmp_t:sock_file write;
allow qcarcam_test_t user_runtime_root_t:dir search;
allow qcarcam_test_t user_runtime_t:dir search;
allow qcarcam_test_t user_tmp_t:sock_file write;
allow qcarcam_test_t usr_t:file { getattr open read };

