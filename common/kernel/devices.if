########################################
## <summary>
##  Read and write the binder device
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_rw_binder_dev',`
    gen_require(`
        type binderfs_t, binder_device_t;
    ')

    rw_chr_files_pattern($1, binderfs_t, binder_device_t)
    allow $1 binder_device_t:chr_file map;
')

########################################
## <summary>
##  Read and write the binder device
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_rw_ashmem_dev',`
    gen_require(`
        type device_t, ashmem_device_t;
    ')

    rw_chr_files_pattern($1, device_t, ashmem_device_t)
    allow $1 ashmem_device_t:chr_file map;
')

########################################
## <summary>
##  Manage generic socket files in /dev.
## </summary>
## <param name="domain">
##  <summary>
##  Domain to not audit.
##  </summary>
## </param>
#
interface(`dev_manage_generic_sockets',`
    gen_require(`
        type device_t;
    ')

    manage_sock_files_pattern($1, device_t, device_t)
')

########################################
## <summary>
##  Don't audit scmnode_sec device (/dev/scmnode_sec).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_dontaudit_scmnode_sec_dev',`
    gen_require(`
        type scmnode_sec_device_t;
    ')

    dontaudit $1 scmnode_sec_device_t:chr_file rw_chr_file_perms;
')

########################################
## <summary>
##  Read and write the scmnode_sec device
