interface(`dev_rw_ashmem_dev',`
    gen_require(`
        type device_t, ashmem_device_t;
    ')

    rw_chr_files_pattern($1, device_t, ashmem_device_t)
    allow $1 ashmem_device_t:chr_file map;
')

########################################
## <summary>
##  Manage generic socket files in /dev.
## </summary>
## <param name="domain">
##  <summary>
##  Domain to not audit.
##  </summary>
## </param>
#
interface(`dev_manage_generic_sockets',`
    gen_require(`
        type device_t;
    ')

    manage_sock_files_pattern($1, device_t, device_t)
')

########################################
## <summary>
##  Getattr usbfs filesystem.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_getattr_usbfs',`
    gen_require(`
        type usbfs_t;
    ')

    allow $1 usbfs_t:filesystem getattr;
')
