type safety_config_etc_t;

# Allow systemd-tmpfiles to manage generic tmp/var labeled objects
# during early boot.
optional_policy(`
  systemd_tmpfilesd_managed(var_t)
')
optional_policy(`
  systemd_tmpfilesd_managed(tmp_t)
')
