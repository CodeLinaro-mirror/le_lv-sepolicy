########################################
## <summary>
## Allow open access for all unallocated
## tty device nodes.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`term_open_unallocated_ttys',`
    gen_require(`
        type tty_device_t;
    ')

    dev_list_all_dev_nodes($1)
    allow $1 tty_device_t:chr_file open;
')

########################################
## <summary>
## Allow read write open and ioctl for ptmx_t
## tty device nodes.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`term_rw_ptmx_chr_files',`
    gen_require(`
        type ptmx_t;
    ')

    rw_chr_files_pattern($1, ptmx_t, ptmx_t);
')

########################################
## <summary>
## Allow read write open and ioctl for ptmx_t
## tty device nodes.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`term_rw_devpts_chr_files',`
    gen_require(`
        type devpts_t;
    ')

    rw_chr_files_pattern($1, devpts_t, devpts_t);
')
