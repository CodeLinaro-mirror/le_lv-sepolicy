########################################
## <summary>
##  Map X keyboard extension libraries.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`xserver_map_xkb_libs',`
    gen_require(`
        type xkb_var_lib_t;
    ')

    allow $1 xkb_var_lib_t:file map;
')
