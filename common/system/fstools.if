########################################
## <summary>
##  Transition to fsadm_t when NNP has been set.
## </summary>
## <param name="domain">
##  <summary>
##  The type of the process performing this action.
##  </summary>
## </param>
#
interface(`fstools_nnp_trans',`
    gen_require(`
        type fsadm_t;
    ')

    allow $1 fsadm_t:process2 nnp_transition;
')
