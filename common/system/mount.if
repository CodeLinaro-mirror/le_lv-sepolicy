########################################
## <summary>
##  Transition to mount_t when NNP has been set.
## </summary>
## <param name="domain">
##  <summary>
##  The type of the process performing this action.
##  </summary>
## </param>
#
interface(`mount_nnp_trans',`
    gen_require(`
        type mount_t;
    ')

    allow $1 mount_t:process2 nnp_transition;
')
