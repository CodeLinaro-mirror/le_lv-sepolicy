########################################
# systemd-nspawn (AV-container)
#
# The container is started from an init script as
#   systemd-nspawn --volatile=yes --machine=AV-container ...
# so nspawn runs in systemd_nspawn_t while it populates the volatile tmpfs
# root and stats every bind-mount source named on the command line.

gen_require(`
    type systemd_nspawn_t;
    type tmpfs_t, lib_t, device_t, dosfs_t;
    type kiumd_device_t, ksync_device_t, scmnode_device_t;
')

# nspawn inherits /dev/pts/0 from the init script it was launched from:
#   avc: denied { read write ioctl } comm="systemd-nspawn" tclass=chr_file
#     scontext=...:systemd_nspawn_t tcontext=...:initrc_devpts_t
init_use_inherited_script_ptys(systemd_nspawn_t)

# nspawn reads /proc/sys/fs/* (nr_open, inotify limits) during setup:
#   avc: denied { read open getattr ioctl } comm="systemd-nspawn" tclass=file
#     scontext=...:systemd_nspawn_t tcontext=...:sysctl_fs_t
kernel_search_fs_sysctls(systemd_nspawn_t)
kernel_read_fs_sysctls(systemd_nspawn_t)

# nspawn statfs()es the cgroup hierarchy to pick the cgroup version:
#   avc: denied { getattr } comm="systemd-nspawn" tclass=filesystem
#     scontext=...:systemd_nspawn_t tcontext=...:cgroup_t
fs_getattr_cgroup(systemd_nspawn_t)

# --volatile=yes gives the container a tmpfs root, which nspawn then fills in
# with the directories, /bin compat symlink, os-release file and device nodes
# the guest expects, and mounts the bind sources on top of them:
#   avc: denied { create mounton setattr } comm="systemd-nspawn" tclass=dir
#     scontext=...:systemd_nspawn_t tcontext=...:tmpfs_t
#   avc: denied { create setattr } name="bin" tclass=lnk_file
#     scontext=...:systemd_nspawn_t tcontext=...:tmpfs_t
fs_manage_tmpfs_dirs(systemd_nspawn_t)
fs_manage_tmpfs_files(systemd_nspawn_t)
fs_manage_tmpfs_symlinks(systemd_nspawn_t)
fs_manage_tmpfs_sockets(systemd_nspawn_t)
fs_manage_tmpfs_blk_files(systemd_nspawn_t)
manage_fifo_files_pattern(systemd_nspawn_t, tmpfs_t, tmpfs_t)
fs_mounton_tmpfs(systemd_nspawn_t)
fs_mounton_tmpfs_files(systemd_nspawn_t)

# nspawn bind-mounts the host's /usr/lib/os-release over the copy it created
# in the volatile root; the host file is labelled lib_t on this image:
#   avc: denied { mounton } comm="systemd-nspawn" tclass=file
#     scontext=...:systemd_nspawn_t tcontext=...:lib_t
allow systemd_nspawn_t lib_t:file mounton;

# nspawn remounts /sys/fs/selinux read-only and mounts it into the container.
# This keeps selinuxfs reachable without enabling the labeled-namespace
# tunable, which stays off on this target:
#   avc: denied { remount } comm="systemd-nspawn" tclass=filesystem
#     scontext=...:systemd_nspawn_t tcontext=...:security_t
#   avc: denied { mounton } comm="systemd-nspawn" tclass=dir
#     scontext=...:systemd_nspawn_t tcontext=...:security_t
selinux_remount_fs(systemd_nspawn_t)
selinux_mounton_dirs(systemd_nspawn_t)

# The command binds /data, which carries the default label on this image:
#   avc: denied { getattr } comm="systemd-nspawn" tclass=dir
#     scontext=...:systemd_nspawn_t tcontext=...:default_t
files_getattr_default_dirs(systemd_nspawn_t)

# nspawn stats each bind source under /dev before adding it to the container
# mount table. Some devtmpfs entries are reported as regular files and others
# as character devices, so keep both permissions metadata-only:
#   avc: denied { getattr } comm="systemd-nspawn" tclass={ file chr_file }
#     scontext=...:systemd_nspawn_t tcontext=...:device_t
allow systemd_nspawn_t device_t:file getattr;
allow systemd_nspawn_t device_t:chr_file getattr;

# The same stat pass covers the Qualcomm-specific device nodes named with
# --bind and DeviceAllow (/dev/kiumd, /dev/ksync, /dev/scmnode):
#   avc: denied { getattr } comm="systemd-nspawn" tclass=chr_file
#     scontext=...:systemd_nspawn_t tcontext=...:{ kiumd ksync scmnode }_device_t
allow systemd_nspawn_t {
    kiumd_device_t ksync_device_t scmnode_device_t
}:chr_file getattr;

# ...and the /firmware bind source, which is a vfat mount:
#   avc: denied { getattr } comm="systemd-nspawn" tclass=dir
#     scontext=...:systemd_nspawn_t tcontext=...:dosfs_t
allow systemd_nspawn_t dosfs_t:dir getattr;

# nspawn stats the shared libraries under the host's /usr/lib while resolving
# the container's dynamic linker search path against the bind mounted host
# tree, repeated for each vendor lib type present there:
#   avc: denied { getattr } comm="systemd-nspawn" tclass=file
#     scontext=...:systemd_nspawn_t tcontext=...:<vendor>_lib_t
gpce_be_getattr_lib_files(systemd_nspawn_t)
keymaster_getattr_lib_files(systemd_nspawn_t)
gptee_getattr_lib_files(systemd_nspawn_t)
getattr_she_lib_files(systemd_nspawn_t)
minkdescriptor_getattr_lib_files(systemd_nspawn_t)
ipp_getattr_lib_files(systemd_nspawn_t)
weston_getattr_lib_files(systemd_nspawn_t)

