## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`unconfined_server_stream_connectto',`
#    gen_require(`
#        type unconfined_service_t;
#    ')

#    allow $1 unconfined_service_t:unix_stream_socket connectto;
')

########################################
## <summary>
##  Send a SIGINH signal to the unconfined domain.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_siginh',`
    gen_require(`
        type unconfined_t;
    ')

    allow $1 unconfined_t:process { siginh noatsecure rlimitinh};
')

########################################
## <summary>
##  Allow apps to rw unix_stream_socket on unconfined user
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_stream_socket_rw',`
    gen_require(`
        type unconfined_t;
    ')

    allow $1 unconfined_t:unix_stream_socket { rw_socket_perms };
')

########################################
## <summary>
## Unconfined binder
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_binder',`
    gen_require(`
        type unconfined_t;
    ')

    allow $1 unconfined_t:binder { call transfer };
')

########################################
## <summary>
## Unconfined system stop
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_system_stop',`
    gen_require(`
        type unconfined_t;
    ')

    allow $1 unconfined_t:system { stop };
')
