########################################
## <summary>
##  Allow ptrace of unconfined domain
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_ptrace',`
    gen_require(`
        type unconfined_t;
    ')

    allow $1 unconfined_t:process ptrace;
')

########################################
