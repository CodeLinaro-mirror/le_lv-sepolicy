policy_module(qseecomd, 1.0)

type qseecomd_t;
type qseecomd_exec_t;
type qseecomd_data_t;
type qseecomd_persist_t;

init_daemon_domain(qseecomd_t, qseecomd_exec_t)

require {
	type device_t;
	type var_t;
	type syslogd_var_run_t;
	type locale_t;
	type devlog_t;
	type sysfs_t;
	type proc_t;
	type default_t;
	type fixed_disk_device_t;
	type etc_t;
	type syslogd_t;
	type init_var_run_t;
	type scsi_generic_device_t;
	type dri_device_t;
	class file { append create getattr open read unlink write };
	class dir { add_name create getattr open read remove_name rmdir search write };
	class lnk_file read;
	class unix_dgram_socket { bind connect create sendto write };
	class capability sys_rawio;
	class process { setcap signull };
	class capability2 block_suspend;
	class sock_file write;
	class chr_file { ioctl open read write };
	class blk_file { open read write };
}

#============= qseecomd_t ==============
allow qseecomd_t default_t:dir { add_name create getattr open read remove_name rmdir search write };
allow qseecomd_t default_t:file { create getattr open read unlink write };
allow qseecomd_t device_t:chr_file { ioctl open read write };
allow qseecomd_t device_t:dir { remove_name write };
allow qseecomd_t devlog_t:sock_file write;
allow qseecomd_t dri_device_t:chr_file { getattr ioctl open read write };
allow qseecomd_t etc_t:file { getattr open read };
allow qseecomd_t etc_t:lnk_file read;

storage_raw_rw_fixed_disk(qseecomd_t)
allow qseecomd_t fixed_disk_device_t:blk_file { open read write };
allow qseecomd_t init_var_run_t:dir search;
allow qseecomd_t locale_t:dir search;
allow qseecomd_t locale_t:file { getattr open read };
allow qseecomd_t proc_t:file { open read };

storage_read_scsi_generic(qseecomd_t)
storage_write_scsi_generic(qseecomd_t)
allow qseecomd_t scsi_generic_device_t:chr_file { ioctl open read write };
allow qseecomd_t self:capability sys_rawio;
allow qseecomd_t self:capability2 block_suspend;
allow qseecomd_t self:process setcap;
allow qseecomd_t self:unix_dgram_socket { bind connect create write };
allow qseecomd_t sysfs_t:file { append open };
allow qseecomd_t syslogd_t:unix_dgram_socket sendto;
allow qseecomd_t syslogd_var_run_t:dir search;
allow qseecomd_t var_t:dir { add_name create read remove_name write };
allow qseecomd_t var_t:file { create getattr open read unlink write };

#============= syslogd_t ==============
allow syslogd_t qseecomd_t:process signull;
