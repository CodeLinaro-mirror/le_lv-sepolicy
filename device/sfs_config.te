policy_module(sfs_config, 1.0)

type sfs_config_initrc_t;
type sfs_config_initrc_exec_t;

init_daemon_domain(sfs_config_initrc_t, sfs_config_initrc_exec_t)

require {
	type default_t;
	type sysfs_t;
	type proc_t;
	type initrc_t;
	type security_t;
	type selinux_config_t;
	type qseecomd_data_t;
	type qseecomd_persist_t;
	class fifo_file { read write getattr };
	class file { create getattr open read write };
	class dir { add_name create getattr search setattr write };
	class chr_file relabelto;
}

filetrans_pattern(sfs_config_initrc_t, default_t, qseecomd_data_t, dir, "tzstorage")

qseecomd_persist_filetrans(sfs_config_initrc_t, dir, "data")

#============= sfs_config_initrc_t ==============
allow sfs_config_initrc_t default_t:dir { add_name create getattr search setattr write };
allow sfs_config_initrc_t self:fifo_file { read write getattr };
allow sfs_config_initrc_t sysfs_t:file { open read getattr };
allow sfs_config_initrc_t proc_t:file { getattr open read };
allow sfs_config_initrc_t security_t:filesystem getattr;
allow sfs_config_initrc_t selinux_config_t:dir search;
allow sfs_config_initrc_t qseecomd_data_t:dir { getattr setattr create };
allow sfs_config_initrc_t qseecomd_persist_t:dir { create getattr setattr };

#============= initrc_t ==============
allow initrc_t qseecomd_persist_t:dir { getattr open read write search};
allow initrc_t qseecomd_data_t:dir { getattr open read write search};
allow initrc_t qseecomd_data_t:file getattr;

files_search_persist(sfs_config_initrc_t)
files_manage_persist_dirs(sfs_config_initrc_t)
