policy_module(qti_adbd, 1.0)

gen_require(`
    class passwd rootok;
')

type adbd_t;
type adbd_exec_t;

init_system_domain(adbd_t, adbd_exec_t)

logging_send_syslog_msg(adbd_t)

# port 5555
corenet_tcp_connect_generic_port(adbd_t)

# Check process info with ps tool from adb shell
sailmb_read_pid(adbd_t)
nsp_drv_read_pid(adbd_t)
adreno200_read_pid(adbd_t)
video_driver_read_pid(adbd_t)
display_be_read_pid(adbd_t)
diag_service_read_pid(adbd_t)
hyp_video_read_pid(adbd_t)
safetymonitor_read_pid(adbd_t)
syscache_rm_read_pid(adbd_t)
eva_auto_read_pid(adbd_t)
audio_service_read_pid(adbd_t)
qcrosvm_read_pid(adbd_t)

# ========== local ==========
allow adbd_t self:unix_dgram_socket { create connect getopt setopt };
allow adbd_t self:tcp_socket { create getopt setopt bind listen accept };
allow adbd_t self:netlink_audit_socket { create nlmsg_relay };
allow adbd_t self:capability { setgid setuid audit_write dac_read_search};
allow adbd_t self:passwd { rootok };
allow adbd_t self:key { write };
