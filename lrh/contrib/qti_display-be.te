policy_module(qti_display-be, 1.0)

type display_be_t;
type display_be_exec_t;
type display_be_tmp_t;
type display_be_tmpfs_t;

init_daemon_domain(display_be_t, display_be_exec_t)

# tmpfs_t not filetrans
fs_manage_tmpfs_files(display_be_t)

dev_rw_dma_dev(display_be_t)
dev_rw_hab_dev(display_be_t)

owfds_map_lib_files(display_be_t)

# ========== local ==========
allow display_be_t self:unix_dgram_socket { create connect };
allow display_be_t self:process { setrlimit setsched };
allow display_be_t self:capability { sys_resource sys_nice };

# /tmp/lrmc_log_(pid).txt
files_tmp_file(display_be_tmp_t)
files_tmp_filetrans(display_be_t, display_be_tmp_t, { dir fifo_file file lnk_file })
manage_files_pattern(display_be_t, display_be_tmp_t, display_be_tmp_t)

# /dev/shm/lrmc_rq_(pid)_l
files_tmpfs_file(display_be_tmpfs_t)
fs_tmpfs_filetrans(display_be_t, display_be_tmpfs_t, file)
manage_files_pattern(display_be_t, display_be_tmpfs_t, display_be_tmpfs_t)
display_be_mmap_rw_tmpfs_files(display_be_t)
