policy_module(qti_fastrpc-rm, 1.0)

type fastrpc_rm_t;
type fastrpc_rm_exec_t;
type fastrpc_rm_tmp_t;
type fastrpc_rm_tmpfs_t;

init_daemon_domain(fastrpc_rm_t, fastrpc_rm_exec_t)

logging_send_syslog_msg(fastrpc_rm_t)

userdom_rw_user_tmp_files(fastrpc_rm_t)
userdom_map_tmp_files(fastrpc_rm_t)
userdom_delete_user_tmp_files(fastrpc_rm_t)

fs_rw_tmpfs_files(fastrpc_rm_t)
fs_map_tmpfs_files(fastrpc_rm_t)

dev_rw_dma_dev(fastrpc_rm_t)
dev_rw_kiumd_dev(fastrpc_rm_t)
dev_rw_vfio_dev(fastrpc_rm_t)
dev_read_sysfs(fastrpc_rm_t)

ssrrm_rw_tmpfs_files(fastrpc_rm_t)
glinkserver_rw_tmpfs_files(fastrpc_rm_t)
audioservice_mmap_rw_tmpfs_files(fastrpc_rm_t)
audioservice_delete_tmpfs_files(fastrpc_rm_t)

glinkserver_ptrace(fastrpc_rm_t)

audio_service_signull(fastrpc_rm_t)

unconfined_server_signull(fastrpc_rm_t)
unconfined_signull(fastrpc_rm_t)
unconfined_server_ptrace(fastrpc_rm_t)
unconfined_ptrace(fastrpc_rm_t)

# ========== local ==========
allow fastrpc_rm_t self:unix_dgram_socket { create connect getopt setopt };
allow fastrpc_rm_t self:capability { sys_resource sys_nice net_admin sys_ptrace dac_override };
allow fastrpc_rm_t self:process { setrlimit setsched };

# /tmp/lrmc_log_(pid).txt
files_tmp_file(fastrpc_rm_tmp_t)
files_tmp_filetrans(fastrpc_rm_t, fastrpc_rm_tmp_t, { dir file })
manage_files_pattern(fastrpc_rm_t, fastrpc_rm_tmp_t, fastrpc_rm_tmp_t)

files_tmpfs_file(fastrpc_rm_tmpfs_t)
fs_tmpfs_filetrans(fastrpc_rm_t, fastrpc_rm_tmpfs_t, { dir file })
fastrpc_rm_create_tmpfs_files(fastrpc_rm_t)
fastrpc_rm_mmap_rw_tmpfs_files(fastrpc_rm_t)
fastrpc_rm_rw_tmpfs_files(fastrpc_rm_t)

#libkiumd
libkiumd_mmap_exec_lib_file(fastrpc_rm_t)
