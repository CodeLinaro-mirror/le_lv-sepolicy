policy_module(qti_qseecomd, 1.0)

type qseecomd_t;
type qseecomd_exec_t;
type qseecomd_data_t;
type qseecomd_initscript_t;
type qseecomd_initscript_exec_t;
type qseecom_device_t;
type qseecomd_persist_t;

init_daemon_domain(qseecomd_t, qseecomd_exec_t)
init_script_file(qseecomd_initscript_exec_t)

dev_associate(qseecom_device_t)

logging_send_syslog_msg(qseecomd_t)

# /sys/power/wake_lock
dev_rw_sysfs(qseecomd_t)

# /dev/qseecom
dev_manage_qseecom(qseecomd_t)
#dev_manage_generic_dirs(qseecomd_t)
dev_read_generic_chr_files(qseecomd_t)

# /sys/power/wake_lock
dev_rw_sysfs(qseecomd_t)

# /dev/vde, dosfs_t
fs_list_dos(qseecomd_t)
fs_read_dos_files(qseecomd_t)

files_list_var(qseecomd_t)
files_manage_var_dirs(qseecomd_t)
files_manage_var_files(qseecomd_t)
files_read_etc_files(qseecomd_t)
files_list_mnt(qseecomd_t)

# local
allow qseecomd_t self:unix_dgram_socket { create connect };
allow qseecomd_t self:capability { setgid setpcap setuid dac_override sys_rawio dac_read_search sys_resource };
allow qseecomd_t self:process { setcap setrlimit };
allow qseecomd_t self:capability2 { block_suspend };

# search root directory
files_list_default(qseecomd_t)

# /data/tzstorage
qseecomd_manage_data(qseecomd_t)

storage_read_scsi_generic(qseecomd_t)
storage_write_scsi_generic(qseecomd_t)
storage_raw_rw_fixed_disk(qseecomd_t)

# /persist/data
qseecomd_rw_persist(qseecomd_t)
qseecomd_manage_persist(qseecomd_t)

# read cmdline in /proc
kernel_read_proc_files(qseecomd_t)

# rw /dev/dma_heap/linux,cma
dev_rw_dma_dev(qseecomd_t)

# /dev/smcinvoke
dev_rw_smcinvoke_dev(qseecomd_t)

# search unlabeled_t type on /data
files_mounton_isid_type_dirs(qseecomd_t)

#libkiumd
libkiumd_mmap_exec_lib_file(qseecomd_t)

# kiumd
dev_rw_kiumd_dev(qseecomd_t)

## tmp files
fs_create_mmap_rw_tmpfs_files(qseecomd_t)
fs_create_write_tmp_files(qseecomd_t)
fs_rw_tmpfs_dirs(qseecomd_t)
fs_delete_tmpfs_files(qseecomd_t)

# openwfds
owfds_map_lib_files(qseecomd_t)
owfds_read_lib_files(qseecomd_t)
