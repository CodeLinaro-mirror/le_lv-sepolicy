## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to softsku_daemon_t.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`softsku_daemon_signull',`
    gen_require(`
        type softsku_daemon_t;
    ')

    allow $1 softsku_daemon_t:process signull;
')
