policy_module(qti_subsys-ramdump-util, 1.0)

type subsys_ramdump_util_t;
type subsys_ramdump_util_exec_t;
type ssrdump_var_t;
type ssrdump_tmp_t;
type ssrdump_tmpfs_t;

init_daemon_domain(subsys_ramdump_util_t, subsys_ramdump_util_exec_t)

logging_send_syslog_msg(subsys_ramdump_util_t)

# Seems checkDiskSpace function in subsys-ramdump-util_main binary
# trigger this fs associate related permission
fs_associate(ssrdump_var_t)

dev_rw_kiumd_dev(subsys_ramdump_util_t)
dev_rw_vfio_dev(subsys_ramdump_util_t)
dev_read_sysfs(subsys_ramdump_util_t)

# ========== local ==========
allow subsys_ramdump_util_t self:unix_dgram_socket { create connect };
allow subsys_ramdump_util_t self:process { setrlimit setsched };
allow subsys_ramdump_util_t self:capability { sys_resource sys_nice };

# /var/ssrdump
files_var_filetrans(subsys_ramdump_util_t, ssrdump_var_t, dir)
manage_dirs_pattern(subsys_ramdump_util_t, ssrdump_var_t, ssrdump_var_t)
files_poly(ssrdump_var_t)

files_tmp_file(ssrdump_tmp_t)
files_tmp_filetrans(subsys_ramdump_util_t, ssrdump_tmp_t, { dir file })
create_files_pattern(subsys_ramdump_util_t, ssrdump_tmp_t, ssrdump_tmp_t)
manage_files_pattern(subsys_ramdump_util_t, ssrdump_tmp_t, ssrdump_tmp_t)

files_tmpfs_file(ssrdump_tmpfs_t)
fs_tmpfs_filetrans(subsys_ramdump_util_t, ssrdump_tmpfs_t, { dir file })
create_files_pattern(subsys_ramdump_util_t, ssrdump_tmpfs_t, ssrdump_tmpfs_t)
manage_files_pattern(subsys_ramdump_util_t, ssrdump_tmpfs_t, ssrdump_tmpfs_t)

#libkiumd
libkiumd_mmap_exec_lib_file(subsys_ramdump_util_t)
