## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Read and write vhost devices (vhost-aud, vhost-cam devices, etc).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_rw_vhost_dev',`
    gen_require(`
        type device_t, vhost_user_device_t;
    ')

    rw_chr_files_pattern($1, device_t, vhost_user_device_t)
')

######################################
## <summary>
##  Read and write vhost devices (vhost-vm3-aud, vhost-vm3-cam, etc).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_rw_vhost_vm3_dev',`
    gen_require(`
        type device_t, vhost_user_device_vm3_t;
    ')

    rw_chr_files_pattern($1, device_t, vhost_user_device_vm3_t)
')

######################################
## <summary>
##  Write vhost-user corresponding sockets.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_write_vhost_socket',`
    gen_require(`
        type vhost_user_tmp_t;
    ')

    allow $1 vhost_user_tmp_t:sock_file write;
')

######################################
## <summary>
##  Write vhost-user corresponding sockets for vm3.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_write_vhost_socket_vm3',`
    gen_require(`
        type vhost_user_tmp_vm3_t;
    ')

    allow $1 vhost_user_tmp_vm3_t:sock_file write;
')

######################################
## <summary>
##  Manage vhost-user tmp files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_manage_tmp_files',`
    gen_require(`
        type vhost_user_tmp_t;
    ')

    manage_files_pattern($1, vhost_user_tmp_t, vhost_user_tmp_t)
    manage_sock_files_pattern($1, vhost_user_tmp_t, vhost_user_tmp_t)
')

######################################
## <summary>
##  Manage vhost-user tmp files for vm3.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_manage_tmp_files_vm3',`
    gen_require(`
        type vhost_user_tmp_vm3_t;
    ')

    manage_files_pattern($1, vhost_user_tmp_vm3_t, vhost_user_tmp_vm3_t)
    manage_sock_files_pattern($1, vhost_user_tmp_vm3_t, vhost_user_tmp_vm3_t)
')

######################################
## <summary>
##  getattr vhost-user corresponding sockets.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_getattr_vhost_socket',`
    gen_require(`
        type vhost_user_tmp_t;
    ')

    allow $1 vhost_user_tmp_t:sock_file getattr;
')

######################################
## <summary>
##  getattr vhost-user corresponding sockets for vm3.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_getattr_vhost_socket_vm3',`
    gen_require(`
        type vhost_user_tmp_vm3_t;
    ')

    allow $1 vhost_user_tmp_vm3_t:sock_file getattr;
')

######################################
## <summary>
##  Create vhost-user corresponding sockets.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_create_vhost_socket',`
    files_tmp_filetrans($1, $2, sock_file, $3)
    fs_associate_tmpfs($2)
    allow $1 $2:sock_file create;
')

########################################
## <summary>
##  Connect to vhost_user_qti_t over a unix stream socket.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`vhost_user_stream_connect_vhostu',`
    gen_require(`
        type vhost_user_qti_t;
    ')

    allow $1 vhost_user_qti_t:unix_stream_socket connectto;
')

########################################
## <summary>
##  Connect to vhost_user_qti_t over a unix stream socket for vm3.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`vhost_user_stream_connect_vhostu_vm3',`
    gen_require(`
        type vhost_user_qti_vm3_t;
    ')

    allow $1 vhost_user_qti_vm3_t:unix_stream_socket connectto;
')

######################################
## <summary>
## Delete generic the vhost-aud, vhost-cam devices.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_delete_vhost_dev',`
    gen_require(`
        type device_t, vhost_user_device_t;
    ')

    delete_chr_files_pattern($1, device_t, vhost_user_device_t)
')

######################################
## <summary>
## Delete generic the vhost-vm3-aud, vhost-vm3-cam devices.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`vhost_user_delete_vhost_dev_vm3',`
    gen_require(`
        type device_t, vhost_user_device_vm3_t;
    ')

    delete_chr_files_pattern($1, device_t, vhost_user_device_vm3_t)
')
