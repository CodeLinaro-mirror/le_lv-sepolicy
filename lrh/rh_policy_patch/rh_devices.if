########################################
## <summary>
##  Read and write scmnode device (/dev/scmnode).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_rw_scmnode_dev',`
    gen_require(`
        type device_t, scmnode_device_t;
    ')

    rw_chr_files_pattern($1, device_t, scmnode_device_t)
')

########################################
## <summary>
##  Don't audit scmnode device (/dev/scmnode).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_dontaudit_scmnode_dev',`
    gen_require(`
        type scmnode_device_t;
    ')

    dontaudit $1 scmnode_device_t:chr_file rw_chr_file_perms;
')

