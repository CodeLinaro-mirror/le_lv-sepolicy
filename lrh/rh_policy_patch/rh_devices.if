## <summary>Policy for SELinux policy and userland applications.</summary>

########################################
## <summary>
##  Read and write smcinvoke
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_rw_smcinvoke_dev',`
    gen_require(`
        type smcinvoke_device_t;
    ')

    rw_chr_files_pattern($1, device_t, smcinvoke_device_t)
')

########################################
## <summary>
##  Read and write gunyah devices (/dev/gunyah).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`dev_rw_gunyah_dev',`
    gen_require(`
        type device_t, gunyah_device_t;
    ')

    rw_chr_files_pattern($1, device_t, gunyah_device_t)
')

