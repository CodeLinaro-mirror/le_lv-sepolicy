policy_module(rh_pcp, 1.0)

require {
    type pcp_pmcd_t;
    type pcp_pmie_t;
    type pcp_pmlogger_t;
    type pcp_pmproxy_t;
}

allow pcp_pmproxy_t self:capability dac_override;

files_manage_var_files(pcp_pmcd_t)
files_manage_var_files(pcp_pmie_t)
files_manage_var_files(pcp_pmlogger_t)
files_manage_var_files(pcp_pmproxy_t)
files_manage_var_dirs(pcp_pmcd_t)
files_manage_var_dirs(pcp_pmie_t)
files_manage_var_dirs(pcp_pmlogger_t)
files_manage_var_dirs(pcp_pmproxy_t)
files_manage_var_sockfiles(pcp_pmcd_t)
fs_manage_tracefs_dirs(pcp_pmcd_t)
fs_manage_dos_dirs(pcp_pmcd_t)
fs_manage_tracefs_files(pcp_pmcd_t)
kernel_rw_net_sysctls(pcp_pmproxy_t)
corenetwork_connect_redis_port(pcp_pmproxy_t)
corenet_tcp_bind_generic_node(pcp_pmcd_t)
files_manage_default_dirs(pcp_pmie_t)
files_manage_default_files(pcp_pmie_t)