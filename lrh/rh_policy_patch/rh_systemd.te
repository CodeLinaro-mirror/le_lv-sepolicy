policy_module(rh_systemd, 1.0)

require {
    type systemd_logind_t;
    type systemd_tmpfiles_t;
    type systemd_coredump_t;
    type systemd_modules_load_t;
    type systemd_resolved_t;
    type systemd_sleep_t;
}

vhost_user_getattr_vhost_socket(systemd_tmpfiles_t)
vhost_user_getattr_vhost_socket_vm3(systemd_tmpfiles_t)
term_getattr_generic_ptys(systemd_logind_t)
weston_delete_tmpfs_sock_files(systemd_logind_t)

weston_map_lib_files(systemd_coredump_t)
owfds_map_lib_files(systemd_coredump_t)
libkiumd_mmap_exec_lib_file(systemd_coredump_t)

#libkiumd
libkiumd_ioctl_lib_file(systemd_coredump_t)

allow systemd_logind_t self:capability net_admin;
allow systemd_tmpfiles_t self:capability net_admin;
allow systemd_modules_load_t self:capability net_admin;

logging_dgram_send(systemd_resolved_t)
corenet_tcp_bind_generic_node(systemd_resolved_t)
corenet_udp_bind_generic_node(systemd_resolved_t)

logging_dgram_send(systemd_sleep_t)
