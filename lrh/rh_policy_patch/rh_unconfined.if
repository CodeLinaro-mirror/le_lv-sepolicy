## <summary>Policy for SELinux policy and userland applications.</summary>

########################################
## <summary>
##  Allow ptrace to unconfined process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_server_ptrace',`
    gen_require(`
        type unconfined_service_t;
    ')

    allow $1 unconfined_service_t:process ptrace;
')

########################################
## <summary>
##  Allow read and search unconfined files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`unconfined_server_read_files',`
    gen_require(`
        type unconfined_service_t;
    ')

    read_files_pattern($1, unconfined_service_t, unconfined_service_t)
')
