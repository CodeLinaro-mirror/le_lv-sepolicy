policy_module(rh_unconfined, 1.0)

require {
    type unconfined_service_t;
    type unconfined_t;
}

qseecomd_manage_data(unconfined_service_t)
qseecomd_setattr_data(unconfined_service_t)
qseecomd_setattr_persist(unconfined_service_t)
qseecomd_rw_persist(unconfined_service_t)

# shell domain is unconfined_t instead of unconfined_service_t when login with ssh or serials.
qseecomd_manage_data(unconfined_t)
qseecomd_setattr_data(unconfined_t)
qseecomd_setattr_persist(unconfined_t)
qseecomd_rw_persist(unconfined_t)
