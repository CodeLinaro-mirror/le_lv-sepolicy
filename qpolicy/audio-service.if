## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Check audio-service related process infomation, such as ps tool.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audio_service_read_pid',`
    gen_require(`
        type audio_service_t;
    ')

    files_search_pids($1)
    read_files_pattern($1, audio_service_t, audio_service_t)
')

######################################
## <summary>
##  Send signull to audio-service related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audio_service_signull',`
    gen_require(`
        type audio_service_t;
    ')

    allow $1 audio_service_t:process signull;
')

######################################
## <summary>
##  Map, read and write audio-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_mmap_rw_tmpfs_files',`
    gen_require(`
        type audio_service_tmpfs_t;
    ')

    mmap_rw_files_pattern($1, audio_service_tmpfs_t, audio_service_tmpfs_t)
')

######################################
## <summary>
##  Delete audio-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_delete_tmpfs_files',`
    gen_require(`
        type audio_service_tmpfs_t;
    ')

    delete_files_pattern($1, audio_service_tmpfs_t, audio_service_tmpfs_t)
')


######################################
## <summary>
##  Read and write audio-service config files in /etc/acdbdata.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_rw_etc_files',`
    gen_require(`
        type audio_etc_t;
    ')

    list_dirs_pattern($1, audio_etc_t, audio_etc_t)
    rw_files_pattern($1, audio_etc_t, audio_etc_t)
')

######################################
## <summary>
##  Read audio-service config files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_read_etc_files',`
    gen_require(`
        type audio_etc_t;
    ')

    read_files_pattern($1, audio_etc_t, audio_etc_t)
')

######################################
## <summary>
##  Create read and write /etc
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_rw_chime_etc_files',`
    gen_require(`
        type etc_t, etc_runtime_t;
    ')
    read_files_pattern($1, etc_t, etc_runtime_t)
    create_files_pattern($1, etc_t, etc_t)
    mmap_rw_files_pattern($1, etc_t, etc_t, file)
')

######################################
## <summary>
##  Read and write audio device (/dev/ipc_shmem)
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_rw_audio_dev',`
    gen_require(`
        type device_t, audio_device_t;
    ')

    rw_chr_files_pattern($1, device_t, audio_device_t)
')

######################################
## <summary>
##  MMAP audio device (/dev/ipc_shmem)
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_mmap_audio_dev',`
    gen_require(`
        type audio_device_t;
    ')

    allow $1 audio_device_t:chr_file map;
')

######################################
## <summary>
##  Write audio power
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_write_audio_power',`
    gen_require(`
        type audio_power_t;
    ')

    allow $1 audio_power_t:sock_file write;
')

######################################
## <summary>
##  Sock audio service
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`audioservice_connect_audio_sock',`
    gen_require(`
        type audio_service_t;
    ')

    allow $1 audio_service_t:unix_stream_socket connectto;
')

########################################
## <summary>
## Allow audio-service domains to communicate with each other over D-Bus.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`audioservice_dbus_chat',`
    gen_require(`
        type audio_service_t;
        class dbus { send_msg acquire_svc };
    ')

    allow $1 audio_service_t:dbus { send_msg acquire_svc };
')

########################################
## <summary>
## Allow audio-service domains to use UNIX sockets for inter-process communication.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`audioservice_ipc_sockets',`
    gen_require(`
        type audio_service_t;
    ')

    allow $1 audio_service_t:unix_dgram_socket { create connect getopt setopt };
    allow $1 audio_service_t:unix_stream_socket connectto;
')

########################################
## <summary>
## Allow audio-service domains to manage process and capabilities for coordination.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`audioservice_process_control',`
    gen_require(`
        type audio_service_t;
    ')

    allow $1 audio_service_t:process { setrlimit setsched ptrace getsched signull };
    allow $1 audio_service_t:capability { sys_resource sys_nice net_admin sys_ptrace dac_override };
')

########################################
## <summary>
## Allow audio-service domains to use TCP sockets for communication.
## </summary>
## <param name="domain">
## <summary>
## Domain allowed access.
## </summary>
## </param>
#
interface(`audioservice_tcp_comm',`
    gen_require(`
        type audio_service_t;
    ')

    allow $1 audio_service_t:tcp_socket { accept bind create listen setopt shutdown connect read write };
')