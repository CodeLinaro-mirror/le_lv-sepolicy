## <summary>Policy interface for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to compresmgr related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compresmgr_signull',`
    gen_require(`
        type compresmgr_t;
    ')

    allow $1 compresmgr_t:process signull;
')
