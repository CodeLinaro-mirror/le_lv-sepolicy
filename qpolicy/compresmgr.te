policy_module(compresmgr, 1.0)

type compresmgr_t;
type compresmgr_exec_t;
type compresmgr_tmpfs_t;
type compresmgr_etc_t;
type compresmgr_power_t;

#============= compresmgr_t ==============
init_daemon_domain(compresmgr_t, compresmgr_exec_t)

init_rw_script_stream_sockets(compresmgr_t)
init_signull_script(compresmgr_t)

#to allow access to /etc/compresmgr_cpu_config.xml
files_config_file(compresmgr_etc_t)
compresmgr_rw_etc_files(compresmgr_t)

libkiumd_ioctl_lib_file(compresmgr_t)
libkiumd_mmap_exec_lib_file(compresmgr_t)
dev_rw_kiumd_dev(compresmgr_t)
dev_rw_l3cache_config_dev(compresmgr_t)

allow compresmgr_t self:process { setrlimit setsched getsched signull signal };
allow compresmgr_t self:unix_dgram_socket { create connect };
allow compresmgr_t self:capability { sys_resource sys_nice net_admin};
allow compresmgr_t compresmgr_tmpfs_t:file { map open read write };

unconfined_server_signull(compresmgr_t)
dev_manage_sysfs_dirs(compresmgr_t)
dev_rw_vfio_dev(compresmgr_t)
dev_read_sysfs(compresmgr_t)


logging_create_devlog_dev(compresmgr_t)
logging_send_syslog_msg(compresmgr_t)

files_manage_generic_tmp_dirs(compresmgr_t)
files_manage_generic_tmp_files(compresmgr_t)

files_read_etc_files(compresmgr_t)

fs_manage_tmpfs_files(compresmgr_t)
fs_map_tmpfs_files(compresmgr_t)

userdom_manage_tmp_files(compresmgr_t)
userdom_mmap_rw_inherited_user_tmp_files(compresmgr_t)
sysnet_manage_config(compresmgr_t)

weston_mmap_rw_tmpfs_files(compresmgr_t)
weston_signull(compresmgr_t)

adreno200_mmap_rw_tmpfs_files(compresmgr_t)
adreno200_signull(compresmgr_t)

safetymonitor_rw_tmpfs_files(compresmgr_t)

#power manager power_use_pm_register
power_use_pm_register(compresmgr_t, compresmgr_power_t)

# map /dev/shm/lrmc_rq_*
userdom_rw_user_tmpfs_files(compresmgr_t)
userdom_map_user_tmpfs_files(compresmgr_t)
userdom_delete_user_tmpfs_files(compresmgr_t)
unconfined_signull(compresmgr_t)
pilrm_rw_tmpfs_files(compresmgr_t)

#for MPAM configfs mkdirs
fs_create_configfs_dirs(compresmgr_t)
fs_rw_configfs_files(compresmgr_t)
fs_create_configfs_files(compresmgr_t)

