## <summary>Policy interface for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to compute-ressched related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compressch_signull',`
    gen_require(`
        type compressch_t;
    ')

    allow $1 compressch_t:process signull;
')

######################################
## <summary>
##  Allow transition to compute-ressched domain under NNP.
##  Needed when executing the client from adb shell
## </summary>
## <param name="domain">
##  <summary>
##  domain the client is executed in
##  </summary>
## </param>
#
interface(`compressch_nnp_transition',`
    gen_require(`
        type compressch_t;
    ')

    allow $1 compressch_t:process2 nnp_transition;
')

######################################
## <summary>
##  Read compute-ressched config files under /etc.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compressch_read_etc_files',`
    gen_require(`
        type etc_t;
        type compressch_etc_t;
    ')

    list_dirs_pattern($1, etc_t, compressch_etc_t)
    read_files_pattern($1, etc_t, compressch_etc_t)
    allow $1 compressch_etc_t:file { getattr open read };
')

######################################
## <summary>
##  Create compute-ressched tmpfs files.                                   
## </summary>                                                              
## <param name="domain">                                                   
##  <summary>                                                              
##  Domain allowed.                                                        
##  </summary>                                                             
## </param>                                                                
#                                                                          
interface(`compressch_create_tmpfs_files',`                                
    gen_require(`                                                          
        type compressch_tmpfs_t;                                           
    ')                                                                     
                                                                           
    create_files_pattern($1, compressch_tmpfs_t, compressch_tmpfs_t)       
')                                                                         
                                  
######################################
## <summary>
##  Map, read and write compute-ressched tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compressch_mmap_rw_tmpfs_files',`
    gen_require(`
        type compressch_tmpfs_t;
    ')

    mmap_rw_files_pattern($1, compressch_tmpfs_t, compressch_tmpfs_t)
')

######################################
## <summary>
##  Read compute-ressched tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compressch_read_tmpfs_files',`
    gen_require(`
        type compressch_tmpfs_t;
    ')

    read_files_pattern($1, compressch_tmpfs_t, compressch_tmpfs_t)
')

######################################
## <summary>
##  Unlink compute-ressched tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`compressch_unlink_tmpfs_files',`
    gen_require(`
        type compressch_tmpfs_t;
    ')

    allow $1 compressch_tmpfs_t:file unlink;
')
 


