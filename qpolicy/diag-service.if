## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to diag-service related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diag_service_signull',`
    gen_require(`
        type diag_service_t;
    ')

    allow $1 diag_service_t:process signull;
')

######################################
## <summary>
##  Check diag-service related process infomation, such as ps tool.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diag_service_read_pid',`
    gen_require(`
        type diag_service_t;
    ')

    files_search_pids($1)
    read_files_pattern($1, diag_service_t, diag_service_t)
')

######################################
## <summary>
##  ptrace to diag-service related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diag_service_ptrace',`
    gen_require(`
        type diag_service_t;
    ')

    allow $1 diag_service_t:process ptrace;
')

######################################
## <summary>
##  create files under tmpfs filesystem for diag-service.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diagservice_create_tmpfs_files',`
    gen_require(`
        type diag_service_tmpfs_t;
    ')

    create_files_pattern($1, diag_service_tmpfs_t, diag_service_tmpfs_t)
')

######################################
## <summary>
##  Map, read and write diag-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diagservice_mmap_rw_tmpfs_files',`
    gen_require(`
        type diag_service_tmpfs_t;
    ')

    mmap_rw_files_pattern($1, diag_service_tmpfs_t, diag_service_tmpfs_t)
')

######################################
## <summary>
##  Read and write diagservice-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diagservice_rw_tmpfs_files',`
    gen_require(`
        type diag_service_tmpfs_t;
    ')

    rw_files_pattern($1, diag_service_tmpfs_t, diag_service_tmpfs_t)
')

######################################
## <summary>
##  Delete diagservice-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diagservice_delete_tmpfs_files',`
    gen_require(`
        type diag_service_tmpfs_t;
    ')

    delete_files_pattern($1, diag_service_tmpfs_t, diag_service_tmpfs_t)
')

######################################
## <summary>
##  unlink diagservice-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`diagservice_unlink_tmpfs_files',`
    gen_require(`
        type diag_service_tmpfs_t;
    ')

    allow $1 diag_service_tmpfs_t:file unlink;

')

