## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to fastrpc-rm related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`fastrpc_rm_signull',`
    gen_require(`
        type fastrpc_rm_t;
    ')

    allow $1 fastrpc_rm_t:process signull;
')

######################################
## <summary>
##  Check fastrpc-rm related process infomation, such as ps tool.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`fastrpc_rm_read_pid',`
    gen_require(`
        type fastrpc_rm_t;
    ')

    files_search_pids($1)
    read_files_pattern($1, fastrpc_rm_t, fastrpc_rm_t)
')

######################################
## <summary>
##  ptrace to fastrpc-rm related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`fastrpc_rm_ptrace',`
    gen_require(`
        type fastrpc_rm_t;
    ')

    allow $1 fastrpc_rm_t:process ptrace;
')

######################################
## <summary>
##  Use fastrpc-rm file descriptors.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`fastrpc_rm_use_fds',`
    gen_require(`
        type fastrpc_rm_t;
    ')

    allow $1 fastrpc_rm_t:fd use;
')

######################################
