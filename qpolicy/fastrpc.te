policy_module(fastrpc, 1.0)

type fastrpc_t;
type fastrpc_exec_t;
type fastrpc_tmp_t;
type fastrpc_tmpfs_t;

init_daemon_domain(fastrpc_t, fastrpc_exec_t)

init_rw_script_stream_sockets(fastrpc_t)
init_signull_script(fastrpc_t)
init_ptrace_script(fastrpc_t)

logging_send_syslog_msg(fastrpc_t)

userdom_rw_user_tmp_files(fastrpc_t)
userdom_map_tmp_files(fastrpc_t)
userdom_delete_user_tmp_files(fastrpc_t)
fastrpc_rm_interact(fastrpc_t)
files_manage_var_dirs(fastrpc_t)
files_manage_var_files(fastrpc_t)
files_manage_etc_files(fastrpc_t)
files_watch_var_dirs(fastrpc_t)
ssrrm_rw_tmpfs_files(fastrpc_t)
dev_rw_generic_files(fastrpc_t)
dev_delete_generic_files(fastrpc_t)
dev_manage_generic_sockets(fastrpc_t)
dev_manage_generic_dirs(fastrpc_t)
dev_manage_generic_files(fastrpc_t)
fs_manage_tmpfs_files(fastrpc_t)
fs_manage_tmpfs_dirs(fastrpc_t)
fs_map_tmpfs_files(fastrpc_t)
files_read_var_symlinks(fastrpc_t)
libkiumd_manage_lib_files(fastrpc_t)
libkiumd_mmap_exec_lib_file(fastrpc_t)

# /vendor/dsp - allow fastrpc-debug's reverse listener (frpc_listener2) to
# open DSP shell/skel/oemconfig libraries that the DSP requests via apps_std
# (e.g. /vendor/dsp/<nsp>/oemconfig.so, fastrpc_shell_*).
#
# vendor_search_dir() grants the search-only traversal of /vendor itself
# (labeled vendor_dir_t by the `vendor` module). The firmware_*_dsp_*
# interfaces grant access to the contents of /vendor/dsp.
vendor_search_dir(fastrpc_t)
firmware_search_dsp_dirs(fastrpc_t)
firmware_read_dsp_lnk_files(fastrpc_t)
firmware_read_dsp_files(fastrpc_t)

# /usr/share/fastrpc/testsig-*.so
files_read_usr_files(fastrpc_t)

allow fastrpc_t self:capability { sys_resource };
allow fastrpc_t self:process signal;
