policy_module(gpce_be, 1.0)

type gpce_be_t;
type gpce_be_exec_t;
type gpce_be_lib_t;
type gpce_be_dev_t;
type gpce_be_tmpfs_t;
type gpce_be_tmp_t;
type gpce_be_etc_t;
type gpce_be_power_t;
type gpce_be_run_t;

require {
    type compresmgr_etc_t;
    type initrc_t;
    type power_qcom_pm_t;
    type safetymonitor_t;
    type tmpfs_t;
    class file { getattr map open read setattr write };
    class process signull;
    class process2 nnp_transition;
    class sock_file unlink;
}

init_daemon_domain(gpce_be_t,gpce_be_exec_t)

# systemd starts gpce_be with no_new_privs set from initrc_t.
allow initrc_t gpce_be_t:process2 nnp_transition;

init_rw_script_stream_sockets(gpce_be_t)
init_signull_script(gpce_be_t)

# allow access to /etc/security/gpce_config.xml
files_config_file(gpce_be_etc_t)
gpce_be_rw_etc_files(gpce_be_t)
files_read_etc_files(gpce_be_t)
allow gpce_be_t compresmgr_etc_t:file { getattr open read };

dev_node(gpce_be_dev_t)

gpce_be_rw_scmi_dev(gpce_be_t)
gpce_be_read_lib_files(gpce_be_t)
gpce_be_map_lib_files(gpce_be_t)
gpce_be_manage_lib_files(gpce_be_t)
gpce_be_delete_tmpfs_files(gpce_be_t)
gpce_be_create_tmpfs_files(gpce_be_t)
gpce_be_mmap_rw_tmpfs_files(gpce_be_t)
gpce_be_rw_tmpfs_files(gpce_be_t)
dev_rw_hab_dev(gpce_be_t)
ipp_gpce_be_process(gpce_be_t)
safetymonitor_rw_tmpfs_files(gpce_be_t)

# Safety Monitor reads/writes GPCE LRMC queues and monitors gpce_be.
allow safetymonitor_t gpce_be_tmpfs_t:file { getattr open read write map };
allow safetymonitor_t gpce_be_t:process signull;

# /dev/shm/lrmc_rq_*
files_tmpfs_file(gpce_be_tmpfs_t)
fs_tmpfs_filetrans(gpce_be_t, gpce_be_tmpfs_t, { dir file })
# Allow gpce_be to access LRMC queue files created under tmpfs by ippserver.
fs_create_mmap_rw_tmpfs_files(gpce_be_t)
ipp_use_fds(gpce_be_t)

# /usr/lib/libkiumd,liblrms,liblrmc
libkiumd_mmap_exec_lib_file(gpce_be_t)

#============ gpce_be_t ===========
logging_send_syslog_msg(gpce_be_t)

fs_delete_tmpfs_files(gpce_be_t)

userdom_rw_user_tmp_files(gpce_be_t)
userdom_delete_user_tmp_files(gpce_be_t)
userdom_map_tmp_files(gpce_be_t)
dev_rw_dma_dev(gpce_be_t)

dev_rw_kiumd_dev(gpce_be_t)
dev_rw_vfio_dev(gpce_be_t)
dev_read_sysfs(gpce_be_t)
kernel_search_vm_sysctl(gpce_be_t)

unconfined_server_signull(gpce_be_t)
unconfined_server_ptrace(gpce_be_t)
unconfined_signull(gpce_be_t)
unconfined_ptrace(gpce_be_t)

power_use_pm_register(gpce_be_t, gpce_be_power_t)

# Remove a stale socket created with the parent qcom_pm label before registering.
allow gpce_be_t power_qcom_pm_t:sock_file unlink;

# /tmp/lrms_log_*.txt
files_tmp_file(gpce_be_tmp_t)
files_tmp_filetrans(gpce_be_t, gpce_be_tmp_t, { dir file })
manage_files_pattern(gpce_be_t, gpce_be_tmp_t, gpce_be_tmp_t)

#================local===================
allow gpce_be_t self:process { setrlimit setsched getsched signal };
allow gpce_be_t self:capability { sys_resource sys_nice dac_override};
allow gpce_be_t tmpfs_t:file setattr;
allow gpce_be_t gpce_be_tmpfs_t:file setattr;

pilrm_use_lrm_run_dir(gpce_be_t)

# gpce_be creates gpce_be_server.sock directly under /run (var_run_t);
# transition it to its own dedicated type instead of the shared
# var_run_t:
files_runtime_file(gpce_be_run_t)
files_pid_filetrans(gpce_be_t, gpce_be_run_t, sock_file)
manage_sock_files_pattern(gpce_be_t, gpce_be_run_t, gpce_be_run_t)
