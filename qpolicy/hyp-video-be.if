## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to hyp-video-be related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hyp_video_signull',`
    gen_require(`
        type hyp_video_t;
    ')

    allow $1 hyp_video_t:process signull;
')

######################################
## <summary>
##  Check hyp-video-be related process infomation, such as ps tool.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hyp_video_read_pid',`
    gen_require(`
        type hyp_video_t;
    ')

    files_search_pids($1)
    read_files_pattern($1, hyp_video_t, hyp_video_t)
')

######################################
## <summary>
##  ptrace to hyp-video-be related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hyp_video_ptrace',`
    gen_require(`
        type hyp_video_t;
    ')

    allow $1 hyp_video_t:process ptrace;
')

######################################
## <summary>
##  Read and write hyp-video-be tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hypvb_rw_tmpfs_files',`
    gen_require(`
        type hyp_video_tmpfs_t;
    ')

    rw_files_pattern($1, hyp_video_tmpfs_t, hyp_video_tmpfs_t)
')

######################################
## <summary>
##  Delete hyp-video-be tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hypvb_delete_tmpfs_files',`
    gen_require(`
        type hyp_video_tmpfs_t;
    ')

    allow $1 hyp_video_tmpfs_t:file_class_set delete_file_perms;
')

######################################
## <summary>
##  Getattri to hyp-video-be tmpfs fifo files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hypvb_getattr_tmpfs_fifo_files',`
    gen_require(`
        type hyp_video_tmpfs_t;
    ')

    getattr_fifo_files_pattern($1, hyp_video_tmpfs_t, hyp_video_tmpfs_t)
')

######################################
## <summary>
##  List to hyp-video-be tmpfs directories.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`hypvb_list_tmpfs_dirs',`
    gen_require(`
        type hyp_video_tmpfs_t;
    ')

    list_dirs_pattern($1, hyp_video_tmpfs_t, hyp_video_tmpfs_t)
')
