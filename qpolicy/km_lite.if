## <summary>Policy for SELinux policy and userland applications.</summary>

########################################
## <summary>
##  mmap to KeyMaster library files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`keymaster_mmap_lib_files',`
    gen_require(`
        type keymaster_lib_t;
    ')

    allow $1 keymaster_lib_t:file mmap_exec_file_perms;
')


