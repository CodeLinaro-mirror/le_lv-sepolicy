##  </summary>
## </param>
#
interface(`libkiumd_manage_lib_files',`
    gen_require(`
        type libkiumd_lib_t, lib_t;
    ')

    manage_files_pattern($1, lib_t, libkiumd_lib_t)
')

########################################
## <summary>
##  Read libkiumd library files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`libkiumd_read_lib_files',`
    gen_require(`
        type libkiumd_lib_t, lib_t;
    ')

    read_files_pattern($1, lib_t, libkiumd_lib_t)
')
