policy_module(owfds, 1.0)

type bridgeship_server_t;
type bridgeship_server_exec_t;
type openwfd_server_t;
type openwfd_server_exec_t;
type openwfd_lib_t;
type openwfd_tmp_t;
type openwfd_tmpfs_t;
type openwfd_server_dev_t;
type openwfd_server_power_t;
type vfio_dpu_safe_device_0_t;
type vfio_dpu_safe_device_1_t;

init_daemon_domain(bridgeship_server_t, bridgeship_server_exec_t)
init_daemon_domain(openwfd_server_t, openwfd_server_exec_t)

init_signull_script(openwfd_server_t)
init_rw_script_stream_sockets(openwfd_server_t)
init_ptrace_script(openwfd_server_t)
init_telinit(openwfd_server_t)

init_rw_script_stream_sockets(bridgeship_server_t)

dev_node(openwfd_server_dev_t)
dev_node(vfio_dpu_safe_device_0_t)
dev_node(vfio_dpu_safe_device_1_t)

openwfd_server_rw_dev(openwfd_server_t)

files_tmp_file(openwfd_tmp_t)
files_tmpfs_file(openwfd_tmpfs_t)

#============ bridgeship_server_t ===========
logging_send_syslog_msg(bridgeship_server_t)

# /tmp/lrms_log_*.txt
files_tmp_filetrans(bridgeship_server_t, openwfd_tmp_t, { dir file })
fs_tmpfs_filetrans(bridgeship_server_t, openwfd_tmpfs_t, { dir file })
manage_files_pattern(bridgeship_server_t, openwfd_tmp_t, openwfd_tmp_t)
manage_files_pattern(bridgeship_server_t, openwfd_tmpfs_t, openwfd_tmpfs_t)

allow bridgeship_server_t self:unix_dgram_socket { create connect write getopt setopt };
allow bridgeship_server_t self:process { setrlimit setsched getsched };
allow bridgeship_server_t self:capability { sys_resource sys_nice net_admin sys_ptrace };

#============ openwfd_server_t ===========
logging_send_syslog_msg(openwfd_server_t)

fs_delete_tmpfs_files(openwfd_server_t)

corecmd_check_exec_bin_files(openwfd_server_t)
corecmd_read_bin_files(openwfd_server_t)

userdom_rw_user_tmp_files(openwfd_server_t)
userdom_delete_user_tmp_files(openwfd_server_t)
userdom_map_tmp_files(openwfd_server_t)

userdom_relabel_user_tmpfs_dirs(openwfd_server_t)
userdom_relabel_user_tmpfs_files(openwfd_server_t)
userdom_user_tmpfs_file(openwfd_server_t)
userdom_map_user_tmpfs_files(openwfd_server_t)
userdom_read_user_tmpfs_files(openwfd_server_t)
userdom_dontaudit_read_user_tmpfs_files(openwfd_server_t)
userdom_rw_user_tmpfs_files(openwfd_server_t)
userdom_delete_user_tmpfs_files(openwfd_server_t)
userdom_manage_user_tmpfs_files(openwfd_server_t)

dev_rw_kiumd_dev(openwfd_server_t)
dev_rw_vfio_dev(openwfd_server_t)
dev_rw_gpiochip_dev(openwfd_server_t)
dev_rw_input_dev(openwfd_server_t)

unconfined_server_signull(openwfd_server_t)
unconfined_server_ptrace(openwfd_server_t)
unconfined_signull(openwfd_server_t)
unconfined_ptrace(openwfd_server_t)
unconfined_server_read_files(openwfd_server_t)
unconfined_use_fds(openwfd_server_t)
unconfined_server_stream_connectto(openwfd_server_t)
weston_signull(openwfd_server_t)
weston_ptrace(openwfd_server_t)
weston_use_fds(openwfd_server_t)

display_be_signull(openwfd_server_t)
display_be_ptrace(openwfd_server_t)
display_be_use_fds(openwfd_server_t)
# /dev/shm/lrmc_rq_(pid)_1
display_be_mmap_rw_tmpfs_files(openwfd_server_t)
display_be_delete_tmpfs_files(openwfd_server_t)

owfds_create_tmpfs_files(openwfd_server_t)
owfds_rw_tmpfs_files(openwfd_server_t)
weston_mmap_rw_tmpfs_files(openwfd_server_t)

weston_delete_tmpfs_files(openwfd_server_t)

fs_getattr_cgroup(openwfd_server_t)
dbus_system_bus_client(openwfd_server_t)
systemd_dbus_chat_logind(openwfd_server_t)
systemd_write_inhibit_pipes(openwfd_server_t)
#/run/systemd/inhibit/1.ref
systemd_use_logind_fds(openwfd_server_t)

qseecomd_signull(openwfd_server_t)

# pm_register
power_use_pm_register(openwfd_server_t, openwfd_server_power_t)

# /sys/devices/soc0/soc_id
dev_read_sysfs(openwfd_server_t)

# /dev/shm/lrmc_rq_*
# Todo, not clear which domain create tmpfs_t objects which audio-service access,
# so file transition rules can't work, use below two interface for the moment
fs_map_tmpfs_files(openwfd_server_t)
fs_rw_tmpfs_files(openwfd_server_t)

# /dev/i2c-18
term_use_unallocated_ttys(openwfd_server_t)

# /usr/lib/libkiumd,liblrms,liblrmc
libkiumd_mmap_exec_lib_file(openwfd_server_t)
libkiumd_mmap_exec_lib_file(bridgeship_server_t)

#smcinvoke_device_t
dev_rw_smcinvoke_dev(openwfd_server_t)
minkdescriptor_mmap_lib_files(openwfd_server_t)

#dma_device_t
dev_rw_dma_dev(openwfd_server_t)

#dosfs_t
files_rw_dosfs_files(openwfd_server_t)

#var_t
files_manage_var_dirs(openwfd_server_t)
files_manage_var_files(openwfd_server_t)
files_read_var_symlinks(openwfd_server_t)
logging_manage_generic_logs(openwfd_server_t)
logging_manage_generic_dirs_logs(openwfd_server_t)
logging_create_generic_logs(openwfd_server_t)

# allow search directory with default_t type
files_search_default(openwfd_server_t)

allow openwfd_server_t self:unix_dgram_socket { create connect getopt setopt };
allow openwfd_server_t self:unix_stream_socket { listen };
allow openwfd_server_t self:process { setrlimit setsched getsched signal };
allow openwfd_server_t self:capability { sys_resource sys_nice net_admin sys_ptrace kill dac_override };
allow openwfd_server_t openwfd_tmpfs_t:file { watch watch_reads map };

files_tmp_filetrans(openwfd_server_t, openwfd_tmp_t, { dir file })
manage_files_pattern(openwfd_server_t, openwfd_tmp_t, openwfd_tmp_t)

fs_tmpfs_filetrans(openwfd_server_t, openwfd_tmpfs_t, { dir file })
manage_files_pattern(openwfd_server_t, openwfd_tmpfs_t, openwfd_tmpfs_t)

compresmgr_rw_etc_files(openwfd_server_t)
compresmgr_rw_etc_files(bridgeship_server_t)

kernel_search_debugfs(openwfd_server_t)
kernel_read_unlabeled_state(openwfd_server_t)
fs_rw_tracefs_files(openwfd_server_t)

#soccp
soccp_driver_rw_tmpfs_files(openwfd_server_t)
soccp_driver_use_fds(openwfd_server_t)
soccp_driver_ptrace(openwfd_server_t)

#============= openwfd_server_t ==============
allow openwfd_server_t openwfd_tmp_t:file { watch watch_reads };
allow openwfd_server_t openwfd_tmpfs_t:file map;
allow openwfd_server_t self:process signull;

compresmgr_rw_etc_files(openwfd_server_t)
safetymonitor_rw_tmpfs_files(openwfd_server_t)

safeserver_rw_vfio_dpu_safe_00_dev(openwfd_server_t)
dev_map_vfio_dpu_safe_00_dev(openwfd_server_t)

safeserver_rw_vfio_dpu_safe_10_dev(openwfd_server_t)
dev_map_vfio_dpu_safe_10_dev(openwfd_server_t)
#xml reading access /etc/safety_config
files_read_safety_config_files(openwfd_server_t)
