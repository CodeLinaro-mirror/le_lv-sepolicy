## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to pil_rm_t.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pil_rm_signull',`
    gen_require(`
        type pil_rm_t;
    ')

    allow $1 pil_rm_t:process signull;
')

######################################
## <summary>
##  create files under tmpfs filesystem for pil-rm.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_create_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    create_files_pattern($1, pil_rm_tmpfs_t, pil_rm_tmpfs_t)
')

######################################
## <summary>
##  Map, read and write pil-rm tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_mmap_rw_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    mmap_rw_files_pattern($1, pil_rm_tmpfs_t, pil_rm_tmpfs_t)
')

######################################
## <summary>
##  Read and write pil-rm tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_rw_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    rw_files_pattern($1, pil_rm_tmpfs_t, pil_rm_tmpfs_t)
')

######################################
## <summary>
##  Read pil-rm tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_read_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    read_files_pattern($1, pil_rm_tmpfs_t, pil_rm_tmpfs_t)
')

######################################
## <summary>
##  Delete pil-rm tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_delete_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    delete_files_pattern($1, pil_rm_tmpfs_t, pil_rm_tmpfs_t)
')

######################################
## <summary>
##  Lock pil-rm tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_lock_tmpfs_files',`
    gen_require(`
        type pil_rm_tmpfs_t;
    ')

    allow $1 pil_rm_tmpfs_t:file lock;
')

######################################
## <summary>
##  Read and write scmi devices.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_rw_scmi_dev',`
    gen_require(`
        type device_t, pil_rm_scmi_dev_t;
    ')

    rw_chr_files_pattern($1, device_t, pil_rm_scmi_dev_t)
')

######################################
## <summary>
##  Create the /dev/pil-done file.
##  Read and write umd pil devices.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_create_pil_done_filetrans',`
    gen_require(`
        type device_t, pil_done_dev_t;
    ')

    allow $1 pil_done_dev_t:file {create write open };
    allow pil_done_dev_t device_t:filesystem associate;
    filetrans_pattern($1, device_t, pil_done_dev_t, file, $2)
')

######################################
## <summary>
##  Read the /dev/pil-done file.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`pilrm_read_pil_done',`
    gen_require(`
        type pil_done_dev_t;
    ')

    read_files_pattern($1, pil_done_dev_t, pil_done_dev_t)
    list_dirs_pattern($1, pil_done_dev_t, pil_done_dev_t)
')

interface(`pilrm_rw_umd_dev',`
    gen_require(`
        type device_t, pil_rm_umd_dev_t;
    ')

    rw_chr_files_pattern($1, device_t, pil_rm_umd_dev_t)
')

########################################
## <summary>
##      map umd_pil device.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`pilrm_map_umd_dev',`
    gen_require(`
        type pil_rm_umd_dev_t;
    ')

    allow $1 pil_rm_umd_dev_t:chr_file map;
')

######################################
## <summary>
##  Search pil-rm run directory (/run/lrm/).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`pilrm_search_run_dir',`
    # /run/lrm/ no longer exists as a dedicated subdirectory; LRM sockets
    # are created directly under /run (var_run_t).
    files_search_pids($1)
')

######################################
## <summary>
##  Create socket files in pil-rm run directory (/run/lrm/).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`pilrm_create_sock_files_run_dir',`
    # /run/lrm/ no longer exists as a dedicated subdirectory; LRM sockets
    # are created directly under /run (var_run_t).
    files_search_pids($1)
    files_manage_var_run_sock_files($1)
')

######################################
## <summary>
##  Connect to sockets in pil-rm run directory (/run/lrm/).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`pilrm_connectto_run_sock_files',`
    gen_require(`
        type pil_rm_t;
    ')

    # /run/lrm/ no longer exists as a dedicated subdirectory; LRM sockets
    # are created directly under /run (var_run_t).
    files_search_pids($1)
    allow $1 var_run_t:sock_file { read write getattr };
    allow $1 pil_rm_t:unix_stream_socket connectto;
')

######################################
## <summary>
##  Full access to /run/lrm/ - search, create/manage sock_files,
##  connect to any LRM service socket (pil_rm, ssr_rm, smcinvoke, self).
##  Use this for any domain that participates in LRM IPC.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`pilrm_use_lrm_run_dir',`
    gen_require(`
        type pil_rm_t;
        type pil_rm_run_t;
        type ssr_rm_t;
        type ssr_rm_run_t;
        type smcinvoke_service_t;
        type smcinvoke_service_run_t;
        type openwfd_server_t;
        type openwfd_server_run_t;
        type glinkserver_t;
        type glinkserver_run_t;
        type syscache_rm_t;
        type syscache_rm_run_t;
        type fastrpc_rm_t;
        type fastrpc_rm_run_t;
        type diag_service_t;
        type diag_service_run_t;
        type safetymonitor_t;
        type safetymonitor_run_t;
        type compresmgr_t;
        type compresmgr_run_t;
        type synxservice_t;
        type synxservice_run_t;
        type video_driver_t;
        type video_driver_run_t;
        type qdss_service_t;
        type qdss_service_run_t;
        type qcx_server_t;
        type qcx_server_run_t;
        type adreno200_t;
        type adreno200_run_t;
        type soccp_driver_t;
        type soccp_driver_run_t;
        type vmm_t;
        type vmm_run_t;
        type nsp_drv_t;
        type nsp_drv_run_t;
        type apss_stl_t;
        type apss_stl_run_t;
        type ecc_err_handler_t;
        type ecc_err_handler_run_t;
        type ssgtz_daemon_t;
        type ssgtz_daemon_run_t;
        type gpce_be_t;
        type gpce_be_run_t;
        type compressch_t;
        type compressch_run_t;
        type subsys_ramdump_util_t;
        type subsys_ramdump_util_run_t;
        type ipp_t;
        type ipp_run_t;
        type eva_auto_t;
        type eva_auto_run_t;
        type compresmon_t;
        type compresmon_run_t;
        type pfm_t;
        type pfm_run_t;
        type nsp_rsm_t;
        type nsp_rsm_run_t;
        type initrc_t;
        type initrc_runtime_t;
    ')

    # /run/lrm/ no longer exists as a dedicated subdirectory; each LRM
    # service now owns a dedicated type for its own socket under /run
    # (var_run_t), created via a creation-time transition in its own
    # policy module (mirrors the per-domain dedicated tmpfs type used
    # for /dev/mqueue, e.g. compressch_tmpfs_t). Clients only need
    # read/write on that dedicated type plus unix_stream_socket
    # connectto -- never create/add_name on the shared var_run_t:
    files_search_pids($1)
    allow $1 pil_rm_run_t:sock_file { read write getattr };
    allow $1 pil_rm_t:unix_stream_socket connectto;
    allow $1 ssr_rm_run_t:sock_file { read write getattr };
    allow $1 ssr_rm_t:unix_stream_socket connectto;
    allow $1 smcinvoke_service_run_t:sock_file { read write getattr };
    allow $1 smcinvoke_service_t:unix_stream_socket connectto;
    allow $1 openwfd_server_run_t:sock_file { read write getattr };
    allow $1 openwfd_server_t:unix_stream_socket connectto;
    allow $1 glinkserver_run_t:sock_file { read write getattr };
    allow $1 glinkserver_t:unix_stream_socket connectto;
    allow $1 syscache_rm_run_t:sock_file { read write getattr };
    allow $1 syscache_rm_t:unix_stream_socket connectto;
    allow $1 fastrpc_rm_run_t:sock_file { read write getattr };
    allow $1 fastrpc_rm_t:unix_stream_socket connectto;
    allow $1 diag_service_run_t:sock_file { read write getattr };
    allow $1 diag_service_t:unix_stream_socket connectto;
    # /run/lrm/safetymonitor.sock -- the safety monitor listens on the shared
    # LRM run directory and every registering client connects to it:
    #   avc: denied { connectto } path="/run/lrm/safetymonitor.sock"
    #     scontext=...:$1 tcontext=...:safetymonitor_t
    allow $1 safetymonitor_run_t:sock_file { read write getattr };
    allow $1 safetymonitor_t:unix_stream_socket connectto;
    allow $1 compresmgr_run_t:sock_file { read write getattr };
    allow $1 compresmgr_t:unix_stream_socket connectto;
    allow $1 synxservice_run_t:sock_file { read write getattr };
    allow $1 synxservice_t:unix_stream_socket connectto;
    allow $1 video_driver_run_t:sock_file { read write getattr };
    allow $1 video_driver_t:unix_stream_socket connectto;
    allow $1 qdss_service_run_t:sock_file { read write getattr };
    allow $1 qdss_service_t:unix_stream_socket connectto;
    allow $1 qcx_server_run_t:sock_file { read write getattr };
    allow $1 qcx_server_t:unix_stream_socket connectto;
    allow $1 adreno200_run_t:sock_file { read write getattr };
    allow $1 adreno200_t:unix_stream_socket connectto;
    allow $1 soccp_driver_run_t:sock_file { read write getattr };
    allow $1 soccp_driver_t:unix_stream_socket connectto;
    allow $1 vmm_run_t:sock_file { read write getattr };
    allow $1 vmm_t:unix_stream_socket connectto;
    allow $1 nsp_drv_run_t:sock_file { read write getattr };
    allow $1 nsp_drv_t:unix_stream_socket connectto;
    allow $1 apss_stl_run_t:sock_file { read write getattr };
    allow $1 apss_stl_t:unix_stream_socket connectto;
    allow $1 ecc_err_handler_run_t:sock_file { read write getattr };
    allow $1 ecc_err_handler_t:unix_stream_socket connectto;
    allow $1 ssgtz_daemon_run_t:sock_file { read write getattr };
    allow $1 ssgtz_daemon_t:unix_stream_socket connectto;
    allow $1 gpce_be_run_t:sock_file { read write getattr };
    allow $1 gpce_be_t:unix_stream_socket connectto;
    allow $1 compressch_run_t:sock_file { read write getattr };
    allow $1 compressch_t:unix_stream_socket connectto;
    allow $1 subsys_ramdump_util_run_t:sock_file { read write getattr };
    allow $1 subsys_ramdump_util_t:unix_stream_socket connectto;
    allow $1 ipp_run_t:sock_file { read write getattr };
    allow $1 ipp_t:unix_stream_socket connectto;
    allow $1 eva_auto_run_t:sock_file { read write getattr };
    allow $1 eva_auto_t:unix_stream_socket connectto;
    allow $1 compresmon_run_t:sock_file { read write getattr };
    allow $1 compresmon_t:unix_stream_socket connectto;
    # /run/pfm.sock -- pfm_service is both an LRM client and server
    # (lrms_open(PFM_DEV_NAME, ...)); other LRM participants connect to
    # its listening socket (e.g. eva_server -> pfm_t):
    #   avc: denied { getattr } path="/run/pfm.sock" tclass=sock_file
    #     scontext=...:$1 tcontext=...:pfm_run_t
    allow $1 pfm_run_t:sock_file { read write getattr };
    allow $1 pfm_t:unix_stream_socket connectto;
    # /run/nsp_rsm.sock -- nsp-rsm calls lrms_open(COMP_RSM_DEV_PATH, ...),
    # making it an LRM server too:
    allow $1 nsp_rsm_run_t:sock_file { read write getattr };
    allow $1 nsp_rsm_t:unix_stream_socket connectto;
    # /run/lrm/qlf_event.sock and /run/lrm/nspconfig_serv.sock are opened by
    # helpers that stay in initrc_t, so the peer label is initrc_t.
    # initrc_t is a shared base-policy domain used by many unrelated init
    # scripts, so we cannot safely give it its own dedicated type here --
    # this is the one remaining exception left on the shared var_run_t:
    #   avc: denied { connectto } path="/run/lrm/qlf_event.sock"
    #     scontext=...:$1 tcontext=...:initrc_t
    allow $1 var_run_t:sock_file { read write getattr };
    allow $1 initrc_t:unix_stream_socket connectto;
    # nspconfig_serv.sock is sometimes created by the initrc_t helper under
    # its own runtime label instead of var_run_t:
    #   avc: denied { write } name="nspconfig_serv.sock" tclass=sock_file
    #     scontext=...:$1 tcontext=...:initrc_runtime_t
    allow $1 initrc_runtime_t:sock_file { read write getattr };
    allow $1 $1:unix_stream_socket connectto;
')
