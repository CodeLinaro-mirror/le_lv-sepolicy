## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to qdss-service related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdss_service_signull',`
    gen_require(`
        type qdss_service_t;
    ')

    allow $1 qdss_service_t:process signull;
')

######################################
## <summary>
##  Check qdss-service related process infomation, such as ps tool.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdss_service_read_pid',`
    gen_require(`
        type qdss_service_t;
    ')

    files_search_pids($1)
    read_files_pattern($1, qdss_service_t, qdss_service_t)
')

######################################
## <summary>
##  ptrace to qdss-service related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdss_service_ptrace',`
    gen_require(`
        type qdss_service_t;
    ')

    allow $1 qdss_service_t:process ptrace;
')

######################################
## <summary>
##  create files under tmpfs filesystem for qdss-service.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_create_tmpfs_files',`
    gen_require(`
        type qdss_service_tmpfs_t;
    ')

    create_files_pattern($1, qdss_service_tmpfs_t, qdss_service_tmpfs_t)
')

######################################
## <summary>
##  Map, read and write qdss-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_mmap_rw_tmpfs_files',`
    gen_require(`
        type qdss_service_tmpfs_t;
    ')

    mmap_rw_files_pattern($1, qdss_service_tmpfs_t, qdss_service_tmpfs_t)
')

######################################
## <summary>
##  Read and write qdssservice-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_rw_tmpfs_files',`
    gen_require(`
        type qdss_service_tmpfs_t;
    ')

    rw_files_pattern($1, qdss_service_tmpfs_t, qdss_service_tmpfs_t)
')

########################################
## <summary>
##  Read and write qdss-service device (/dev/qdss-service).
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`qdssservice_rw_dev',`
    gen_require(`
        type device_t, qdss_service_device_t;
    ')

    rw_chr_files_pattern($1, device_t, qdss_service_device_t)
')


########################################
## <summary>
##      map qdss-service device.
## </summary>
## <param name="domain">
##      <summary>
##      Domain allowed access.
##      </summary>
## </param>
#
interface(`qdssservice_map_dev',`
    gen_require(`
        type qdss_service_device_t;
    ')

    allow $1 qdss_service_device_t:chr_file map;
')
######################################
## <summary>
##  Delete qdss-service tmpfs files.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_delete_tmpfs_files',`
    gen_require(`
        type qdss_service_tmpfs_t;
    ')

    delete_files_pattern($1, qdss_service_tmpfs_t, qdss_service_tmpfs_t)
')

######################################
## <summary>
##  Search the qdss-service dump directory under /var/volatile/log.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_search_var_dirs',`
    gen_require(`
        type qdss_service_var_t;
    ')

    search_dirs_pattern($1, qdss_service_var_t, qdss_service_var_t)
    allow $1 qdss_service_var_t:dir getattr;
')
######################################
## <summary>
##  Create subdirectories under the qdss-service dump directory
##  (/var/volatile/log/qlf_dumps) and write dump files into them.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`qdssservice_manage_var_dumps',`
    gen_require(`
        type qdss_service_var_t;
    ')

    qdssservice_search_var_dirs($1)
    allow $1 qdss_service_var_t:dir { open read write add_name create };
    allow $1 qdss_service_var_t:file { create open read write append
                                       getattr setattr ioctl };
')

######################################
## <summary>
##  Manage subdirectories under the qdss-service var directory
##  (typically /var/log/qlf_dumps/[per-service-subdir]). Grants what
##  a QLF-producing service needs to create and manage its own
##  subdirectory of dumps beneath /var/log/qlf_dumps.
##
##  Note: this permits creating entries INSIDE qdss_service_var_t,
##  not deleting or modifying the parent qdss_service_var_t
##  directory itself. Files and subdirs created here will normally
##  inherit qdss_service_var_t unless the caller declares a
##  name-based type transition.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed access.
##  </summary>
## </param>
#
interface(`qdssservice_manage_var_subdirs',`
    gen_require(`
        type qdss_service_var_t;
    ')

    allow $1 qdss_service_var_t:dir { search getattr open read
                                      add_name remove_name write };
    manage_dirs_pattern($1, qdss_service_var_t, qdss_service_var_t)
    manage_files_pattern($1, qdss_service_var_t, qdss_service_var_t)
')

######################################
## <summary>
##  Auto-transition to qdss_service_t when the calling domain
##  executes qdss_service_exec_t (qdss-service, qdss-util,
##  qdss-sysfs). Required for any parent domain that spawns
##  qdss-util (e.g. tpm) so its LRMC mqueues get the correct label.
## </summary>
## <param name="domain">
##  <summary>
##  Domain that will auto-transition to qdss_service_t on exec.
##  </summary>
## </param>
#
interface(`qdssservice_domtrans',`
    gen_require(`
        type qdss_service_t, qdss_service_exec_t;
    ')

    domtrans_pattern($1, qdss_service_exec_t, qdss_service_t)
    allow $1 qdss_service_t:process { signal signull };
')
