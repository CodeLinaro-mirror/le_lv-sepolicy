## <summary>Policy for SELinux policy and userland applications.</summary>

######################################
## <summary>
##  Send signull to ssgtz_daemon_t.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`ssgtz_daemon_signull',`
    gen_require(`
        type ssgtz_daemon_t;
    ')

    allow $1 ssgtz_daemon_t:process signull;
')

######################################
## <summary>
##  ptrace to ssgtz_daemon_t related process.
## </summary>
## <param name="domain">
##  <summary>
##  Domain allowed.
##  </summary>
## </param>
#
interface(`ssgtz_daemon_ptrace',`
    gen_require(`
        type ssgtz_daemon_t;
    ')

    allow $1 ssgtz_daemon_t:process ptrace;
')

######################################
## <summary>
##  Allow a domain to use file descriptors owned by ssgtz_daemon_t.
## </summary>
## <param name="domain">
##  <summary>
##   Domain that is allowed to use ssgtz_daemon_t FDs.
##  </summary>
## </param>
#
interface(`ssgtz_daemon_use_fds',`
    gen_require(`
        type ssgtz_daemon_t;
    ')

    allow $1 ssgtz_daemon_t:fd use;
')
