policy_module(syscache-rm, 1.0)

type syscache_rm_t;
type syscache_rm_exec_t;
type syscache_rm_tmp_t;
type syscache_rm_tmpfs_t;

init_daemon_domain(syscache_rm_t, syscache_rm_exec_t)

init_rw_script_stream_sockets(syscache_rm_t)

logging_send_syslog_msg(syscache_rm_t)

dev_rw_kiumd_dev(syscache_rm_t)
dev_rw_vfio_dev(syscache_rm_t)
dev_read_sysfs(syscache_rm_t)

userdom_manage_user_tmp_files(syscache_rm_t)
userdom_map_tmp_files(syscache_rm_t)

safetymonitor_rw_tmpfs_files(syscache_rm_t)

#libkiumd
libkiumd_mmap_exec_lib_file(syscache_rm_t)

#adreno200
adreno200_rw_tmpfs_files(syscache_rm_t)
adreno200_signull(syscache_rm_t)
adreno200_mmap_rw_tmpfs_files(syscache_rm_t)
adreno200_delete_tmpfs_files(syscache_rm_t)

# /tmp/lrms_log_*.txt
files_tmp_file(syscache_rm_t)
files_tmp_filetrans(syscache_rm_t, syscache_rm_tmp_t, { dir file })
manage_files_pattern(syscache_rm_t, syscache_rm_tmp_t, syscache_rm_tmp_t)
mmap_read_files_pattern(syscache_rm_t, syscache_rm_tmp_t, syscache_rm_tmp_t)

# map /dev/shm/lrmc_rq_*
files_tmpfs_file(syscache_rm_tmpfs_t)
fs_tmpfs_filetrans(syscache_rm_t, syscache_rm_tmpfs_t, { dir file })
syscache_rm_create_tmpfs_files(syscache_rm_t)
syscache_rm_mmap_rw_tmpfs_files(syscache_rm_t)
syscache_rm_rw_tmpfs_files(syscache_rm_t)
syscache_rm_tmpfs_map_files(syscache_rm_t)
allow syscache_rm_t syscache_rm_tmpfs_t:file map;
allow syscache_rm_t syscache_rm_tmpfs_t:file unlink;

# for syscache_drv_test registering with syscache_rm (user_tmp_t)
userdom_manage_tmp_files(syscache_rm_t)
userdom_map_tmp_files(syscache_rm_t)

# ========== local ==========
allow syscache_rm_t self:unix_dgram_socket { create connect getopt setopt };
allow syscache_rm_t self:process { setrlimit setsched };
allow syscache_rm_t self:capability { sys_resource sys_nice net_admin };

files_tmp_file(syscache_rm_tmp_t)
files_tmp_filetrans(syscache_rm_t, syscache_rm_tmp_t, { dir fifo_file file lnk_file })
userdom_user_tmp_filetrans(syscache_rm_t, syscache_rm_tmp_t, { dir file sock_file } )
manage_files_pattern(syscache_rm_t, syscache_rm_tmp_t, syscache_rm_tmp_t)

files_tmpfs_file(syscache_rm_tmpfs_t)
fs_tmpfs_filetrans(syscache_rm_t, syscache_rm_tmpfs_t, { dir file })
create_files_pattern(syscache_rm_t, syscache_rm_tmpfs_t, syscache_rm_tmpfs_t)
syscacherm_mmap_rw_tmpfs_files(syscache_rm_t)
fs_rw_tmpfs_files(syscache_rm_t)

# for running syscache_drv_test app in adb shell
unconfined_server_signull(syscache_rm_t);
fs_map_tmpfs_files(syscache_rm_t);
fs_rw_tmpfs_files(syscache_rm_t);

