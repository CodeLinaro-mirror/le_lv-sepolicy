#============= hostapd_t ==============
gen_require(`
    type debugfs_t;
    type default_t;
    type etc_runtime_t;
    type initrc_var_run_t;
    type tmp_t;
')
allow hostapd_t debugfs_t:dir search;
allow hostapd_t default_t:file { getattr write };
allow hostapd_t etc_runtime_t:file { getattr open read };
allow hostapd_t etc_t:file map;
allow hostapd_t initrc_t:unix_dgram_socket sendto;
allow hostapd_t initrc_var_run_t:dir { add_name remove_name search write };
allow hostapd_t initrc_var_run_t:sock_file { create setattr unlink write };
allow hostapd_t tmp_t:dir search;
allow hostapd_t tmp_t:sock_file write;
