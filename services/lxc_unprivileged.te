# SELinux policy module for LXC unprivileged container support.
# Allows systemd-based services to run inside user namespace containers.
 
module lxc_unprivileged 1.0;
 
require {
    type initrc_t;
    type systemd_tmpfiles_t;
    type systemd_gpt_generator_t;
    type getty_t;
    type syslogd_t;
    type mount_t;
    type udev_t;
    type tmpfs_t;
    type user_devpts_t;
    type loc_socket_t;
    type initrc_t;
    type system_dbusd_t;
    type kmod_t;
    type audio_vendor_t;
    type weston_t;
    type systemd_logind_t;
    type initrc_devpts_t;
    type gstreamer_t;
    type device_t;
 
    class cap_userns { chown dac_read_search sys_boot fowner setpcap sys_chroot kill sys_admin setuid setgid sys_ptrace fsetid dac_read_search dac_override };
    class capability { sys_ptrace sys_admin dac_read_search dac_override net_admin };
    class process2 { nnp_transition };
    class unix_stream_socket { read write ioctl getattr getopt setopt accept shutdown connectto };
    class unix_dgram_socket { read write getattr getopt setopt sendto };
    class dir { search write add_name create read open getattr remove_name };
    class file { read write open getattr ioctl create setattr rename unlink map };
    class sock_file { write create };
    class lnk_file { read };
    class chr_file { read write open getattr setattr ioctl };
    class filesystem { associate };
    class fifo_file { create read open write unlink };
}
 
# initrc_t: systemd init in user namespace needs cap_userns
allow initrc_t self:cap_userns { chown dac_read_search sys_boot fowner setpcap sys_chroot };
 
# initrc_t -> syslogd_t: nnp_transition for journald under NNP
allow initrc_t syslogd_t:process2 nnp_transition;
 
# syslogd_t (journald): capabilities + tmpfs access
allow syslogd_t self:capability { sys_ptrace sys_admin };
allow syslogd_t tmpfs_t:dir { search write add_name create read open getattr };
allow syslogd_t tmpfs_t:file { read write open getattr ioctl create setattr rename unlink map };
allow syslogd_t tmpfs_t:sock_file { write create };
allow syslogd_t tmpfs_t:lnk_file { read };
allow syslogd_t initrc_t:unix_dgram_socket { read write getattr getopt setopt sendto };
allow syslogd_t initrc_t:unix_stream_socket { read write getattr getopt setopt accept shutdown };
 
# systemd_gpt_generator_t: reads container/proc info
allow systemd_gpt_generator_t tmpfs_t:dir { search read open getattr };
allow systemd_gpt_generator_t tmpfs_t:file { read open getattr ioctl };
allow systemd_gpt_generator_t initrc_t:dir { search };
allow systemd_gpt_generator_t initrc_t:file { read open getattr };
 
# systemd_tmpfiles_t: manages /run/systemd dirs
allow systemd_tmpfiles_t initrc_t:file { read open getattr };
allow systemd_tmpfiles_t initrc_t:unix_stream_socket { read write ioctl };
allow systemd_tmpfiles_t initrc_t:unix_dgram_socket { sendto };
allow systemd_tmpfiles_t tmpfs_t:dir { search write add_name create read open getattr };
allow systemd_tmpfiles_t tmpfs_t:sock_file { write create };
allow systemd_tmpfiles_t loc_socket_t:dir { read open getattr };
allow loc_socket_t tmpfs_t:filesystem { associate };
 
# mount_t: bind mounts inside container
allow mount_t initrc_t:unix_stream_socket { read write };
allow mount_t tmpfs_t:dir { search write add_name create read open getattr };
 
# udev_t: user namespace capability support
allow udev_t self:cap_userns { dac_read_search };
allow udev_t self:capability { dac_read_search dac_override net_admin };
 
# getty_t: suppress non-fatal noise
dontaudit getty_t tmpfs_t:dir { write add_name };
dontaudit getty_t tmpfs_t:file { create read open };
dontaudit getty_t initrc_t:unix_stream_socket { read write };
dontaudit getty_t user_devpts_t:chr_file { read write open getattr setattr ioctl };

#lxc-attach unprivileged
allow initrc_t self:cap_userns { kill };


# -------------------------------------------------------
# New rules derived from AVC denied logs (permissive=1)
# Sep 20 boot sequence in unprivileged LXC container
# -------------------------------------------------------

# syslogd_t (systemd-journal):
allow syslogd_t self:cap_userns { sys_admin setuid setgid sys_ptrace };
allow syslogd_t tmpfs_t:dir { remove_name };

# system_dbusd_t (dbus-daemon):
allow system_dbusd_t self:cap_userns { setuid setgid };
allow system_dbusd_t initrc_t:unix_stream_socket { read write getattr getopt accept };
allow system_dbusd_t tmpfs_t:dir { search };
allow system_dbusd_t tmpfs_t:file { read open getattr };
allow system_dbusd_t tmpfs_t:fifo_file { write };

# initrc_t:
allow initrc_t kmod_t:process2 { nnp_transition };
allow initrc_t systemd_logind_t:process2 { nnp_transition };

# kmod_t (modprobe):
allow kmod_t self:cap_userns { dac_read_search };
allow kmod_t initrc_t:unix_stream_socket { read write };

# audio_vendor_t (acdb_loader_ser):
allow audio_vendor_t self:cap_userns { dac_override };
allow audio_vendor_t initrc_t:unix_stream_socket { read write };
allow audio_vendor_t tmpfs_t:dir { search };

# weston_t (weston-launch):
allow weston_t initrc_t:unix_stream_socket { read write };

# systemd_logind_t:
allow systemd_logind_t initrc_t:unix_stream_socket { read write ioctl connectto };
allow systemd_logind_t initrc_t:unix_dgram_socket { sendto };
allow systemd_logind_t tmpfs_t:file { read open getattr ioctl create write setattr rename unlink };
allow systemd_logind_t tmpfs_t:sock_file { write };
allow systemd_logind_t tmpfs_t:fifo_file { create read open write unlink };

# getty_t (agetty):
allow getty_t self:cap_userns { fsetid };
allow getty_t initrc_devpts_t:chr_file { read write open setattr getattr ioctl };

# video:
allow gstreamer_t tmpfs_t:dir { search };
allow gstreamer_t self:cap_userns { dac_override };
allow gstreamer_t device_t:dir { write add_name remove_name };
allow gstreamer_t device_t:file { create read write open map unlink };
