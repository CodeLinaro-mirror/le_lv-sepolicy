policy_module(qti_ais_server, 1.0)

require {
        type debugfs_t;
        type default_t;
        type device_t;
        type devlog_t;
        type etc_t;
        type gstreamer_t;
        type init_var_run_t;
        type locale_t;
        type qcarcam_test_t;
        type qcarcam_rvc_t;
        type sysfs_t;
        type syslogd_t;
        type syslogd_var_run_t;
        type tmp_t;
        type tmpfs_t;
        type v4l_device_t;
        class chr_file { ioctl map open read write };
        class capability { chown fowner fsetid sys_nice };
        class dir { add_name remove_name search write };
        class fd use;
        class file { getattr create open read write append unlink };
        class fifo_file { read write };
        class lnk_file read;
        class process { setsched signal };
        class sock_file { create setattr write unlink };
        class unix_dgram_socket { connect create sendto write };
        class unix_stream_socket { accept listen };
}


########################################
#
# Declarations
#
type ais_server_t;
type ais_server_exec_t;
init_daemon_domain(ais_server_t, ais_server_exec_t)

type ais_server_etc_t;
files_config_file(ais_server_etc_t)

type ais_server_data_t;
files_type(ais_server_data_t)

type ais_server_socket_device_t;
ref_init_named_socket_activation(ais_server_t, ais_server_socket_device_t)

type ais_server_var_run_t;
files_type(ais_server_var_run_t)

######################################

allow ais_server_t ais_server_data_t:dir search;
allow ais_server_t ais_server_data_t:file { getattr open read };
allow ais_server_t debugfs_t:dir search;
allow ais_server_t default_t:dir search;
allow ais_server_t device_t:chr_file { ioctl map open read write };
allow ais_server_t devlog_t:sock_file write;
allow ais_server_t etc_t:lnk_file read;
allow ais_server_t gstreamer_t:fd use;
allow ais_server_t init_var_run_t:dir search;
allow ais_server_t locale_t:dir search;
allow ais_server_t locale_t:file { open read getattr };
allow ais_server_t qcarcam_test_t:fd use;
allow ais_server_t qcarcam_rvc_t:fd use;
allow ais_server_t self:capability { chown fowner fsetid sys_nice };
allow ais_server_t self:fifo_file { read write };
allow ais_server_t self:process { setsched signal };
allow ais_server_t self:unix_dgram_socket { create connect write };
allow ais_server_t self:unix_stream_socket { accept listen };
allow ais_server_t sysfs_t:file { open write read };
allow ais_server_t syslogd_t:unix_dgram_socket sendto;
allow ais_server_t syslogd_var_run_t:dir search;
allow ais_server_t tmp_t:dir { add_name remove_name search write };
allow ais_server_t tmp_t:file { open create read append unlink getattr };
allow ais_server_t tmp_t:sock_file { create setattr unlink write};
allow ais_server_t tmpfs_t:dir { add_name remove_name search write };
allow ais_server_t tmpfs_t:file { open create read append unlink getattr };
allow ais_server_t tmpfs_t:sock_file { create setattr unlink write};
allow ais_server_t v4l_device_t:chr_file { ioctl open read write };
